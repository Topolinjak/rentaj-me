# Predloga nastavitev. Kopiraj v .env (cp .env.example .env) in po potrebi spremeni.

# PostgreSQL v Docker Compose
POSTGRES_USER=rentaj
POSTGRES_PASSWORD=rentaj
POSTGRES_DB=rentaj
# Vrata baze na gostitelju; spremeni, če je 5432 že zaseden (npr. 5433)
DB_PORT=5432

# Backend
# Povezava z bazo, ko backend teče na gostitelju. V Docker Compose je gostitelj "db" in vrata 5432.
DATABASE_URL=postgresql://rentaj:rentaj@localhost:5432/rentaj
# Skrivnost za podpisovanje JWT; v produkciji dolg naključen niz (npr. openssl rand -hex 32)
JWT_SECRET=spremeni-me
PORT=3000
NODE_ENV=development
